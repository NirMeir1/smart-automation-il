# Copy to .env.local. Keep real credentials private.
NEXT_PUBLIC_SITE_URL=
# Production release only: https://www.bottomline-ai.com and true, then rebuild.
# Preview/development remain blocked even if the production flag is copied.
SITE_INDEXING_ENABLED=false
CONTACT_FORM_ENABLED=false
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
# Recipient is fixed server-side to meirnir89@gmail.com.

# Enable only when the hosting ingress overwrites x-forwarded-for.
CONTACT_TRUST_PROXY=false
# Production requires an HTTPS *.upstash.io REST origin and a read/write token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret of at least 32 characters; share it across instances.
CONTACT_RATE_LIMIT_SECRET=
