# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.npm-cache/
/.tools/

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# lint cache
.eslintcache

# next.js
/.next/
/out/
.turbo

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.key
*.p12
*.pfx
*.log
/.cache/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# private environment files; example files must contain no secrets
.env*
!.env.example

# local assistant settings (already tracked files are unaffected)
/.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo

# removed duplicate project subtree
business-automation/

# Local design concepts and review exports; preserve files outside version control.
/Bottomline-Review-Highlights/
/Bottomline-Video-Directions/
/docs/design-review/
/docs/Typography_Implementation.md
